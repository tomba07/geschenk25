{
  "name": "geschenk",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev:web:live-api",
    "dev:web": "npm run dev --workspace @geschenk/web",
    "dev:web:live-api": "npm run dev:live-api --workspace @geschenk/web",
    "dev:web:local-api": "npm run dev:local-api --workspace @geschenk/web",
    "dev:api": "npm run dev --workspace @geschenk/api",
    "dev:all": "npm run dev:web & npm run dev:api",
    "dev:local-api": "npm run dev:web:local-api & npm run dev:api",
    "start": "npm run dev:web",
    "build": "npm run build:all",
    "build:web": "npm run build --workspace @geschenk/web",
    "build:api": "npm run build --workspace @geschenk/api",
    "build:all": "npm run build:web && npm run build:api",
    "preview": "npm run preview --workspace @geschenk/web",
    "start:api": "npm run start --workspace @geschenk/api",
    "migrate:api": "npm run migrate --workspace @geschenk/api",
    "cleanup:api": "npm run cleanup --workspace @geschenk/api",
    "reset-profile:api": "npm run reset-profile --workspace @geschenk/api --",
    "seed-dev-accounts:api": "npm run seed-dev-accounts --workspace @geschenk/api",
    "link-dev-accounts:api": "npm run link-dev-accounts --workspace @geschenk/api --",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:server": "npm run build:api && npm run migrate:api && npm run seed-dev-accounts:api && sh -c '(curl -fsS http://127.0.0.1:3000/health >/dev/null 2>&1 || npm run dev:api) & npm run dev:local-api --workspace @geschenk/web -- --host 127.0.0.1 --port ${PLAYWRIGHT_WEB_PORT:-5178} --strictPort'"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
