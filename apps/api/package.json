{
  "name": "@geschenk/api",
  "version": "1.0.0",
  "description": "Backend API for geschenk25 app",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:deployed-db": "DOTENV_CONFIG_PATH=.env.deployed-db tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "migrate": "node dist/migrate.js",
    "cleanup": "tsx src/cleanup.ts",
    "reset-profile": "tsx src/resetProfile.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
